generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // transaction-mode pooler (pgbouncer)
  directUrl = env("DIRECT_URL")   // session-mode / direct — used by prisma migrate
}

// ─────────────────────────────────────────────
// Platform (cross-tenant — not part of any org)
// ─────────────────────────────────────────────

model PlatformAdmin {
  id        String   @id @default(uuid())
  authId    String   @unique // Supabase auth.users.id
  email     String   @unique
  fullName  String
  createdAt DateTime @default(now())

  impersonations ImpersonationEvent[]

  @@map("platform_admins")
}

model ImpersonationEvent {
  id              String   @id @default(uuid())
  platformAdminId String
  platformAdmin   PlatformAdmin @relation(fields: [platformAdminId], references: [id])
  targetUserId    String
  targetUser      User     @relation(fields: [targetUserId], references: [id])
  targetOrgName   String   // snapshot — survives the org changing name later
  startedAt       DateTime @default(now())
  endedAt         DateTime?

  @@index([platformAdminId, startedAt])
  @@map("impersonation_events")
}

// ─────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────

model Organization {
  id            String   @id @default(uuid())
  name          String
  subdomain     String   @unique
  plan          String   @default("growth")
  billingDueDay Int      @default(15) // day of month monthly-dues invoices fall due
  gcashNumber         String?
  gcashName           String?
  gcashQrPath         String? // uploaded GCash "receive money" QR image (payment-qr bucket)
  mayaNumber          String?
  mayaName            String?
  mayaQrPath          String? // uploaded Maya QR image
  paymentInstructions String? // bank transfer + cash / office-hours notes
  // Default monthly dues by property type — used when a unit has neither a rate
  // plan nor a custom rate. Null = no default for that type.
  typeRateResidential Decimal? @db.Decimal(12, 2)
  typeRateCommercial  Decimal? @db.Decimal(12, 2)
  typeRateTownhouse   Decimal? @db.Decimal(12, 2)
  // Late fees (opt-in, per HOA). amount is pesos when FIXED, a percent when PERCENT.
  lateFeeEnabled        Boolean     @default(false)
  lateFeeType           LateFeeType @default(FIXED)
  lateFeeAmount         Decimal     @default(0) @db.Decimal(12, 2)
  lateFeeGraceDays      Int         @default(0)
  lateFeeMaxOccurrences Int         @default(1) // cap of late-fee charges per overdue invoice
  privacyContactEmail   String?     // DPO / data-privacy contact shown to residents
  // Water sub-metering (opt-in). `waterRateBands` = JSON array of
  // { upToM3: number|null, pricePerM3: number } ascending, last cap null.
  waterBillingEnabled   Boolean     @default(false)
  waterServiceCharge    Decimal?    @db.Decimal(12, 2)
  waterRateBands        Json?
  createdAt     DateTime @default(now())

  users        User[]
  properties   Property[]
  accounts     Account[]
  journalEntries JournalEntry[]
  ratePlans    RatePlan[]
  announcements Announcement[]
  gatePassScans GatePassScan[]
  auditEvents   AuditEvent[]
  marketplaceListings MarketplaceListing[]
  marketConversations MarketConversation[]
  marketplaceBlocks   MarketplaceBlock[]
  amenities           Amenity[]
  amenityBookings     AmenityBooking[]
  documents           Document[]
  ownershipTransfers  OwnershipTransfer[]
  dataRequests        DataRequest[]
  creditApplications  CreditApplication[]
  refunds             Refund[]
  violations          Violation[]
  fineNotices         FineNotice[]
  vendors             Vendor[]
  bills               Bill[]
  maintenanceRequests MaintenanceRequest[]
  boardMeetings       BoardMeeting[]
  boardVotes          BoardVote[]
  voteProxies         VoteProxy[]
  waterMeters         WaterMeter[]
  meterReadings       MeterReading[]

  @@map("organizations")
}

model AuditEvent {
  id        String   @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorName String   // snapshot — survives the actor later being removed
  action    String   // "invoice.void", "property.archive", "team.remove", …
  target    String?  // human label, e.g. "Blk 1 Lot 3 · Sept 2026"
  detail    String?  // reason / extra context
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
  @@map("audit_events")
}

model RatePlan {
  id          String   @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  monthlyRate Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  properties Property[]

  @@unique([orgId, name])
  @@index([orgId])
  @@map("rate_plans")
}

enum UserRole {
  ADMIN
  TREASURER
  BOARD_MEMBER
  GUARD
  HOMEOWNER
}

model User {
  id         String   @id @default(uuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  authId     String?  @unique // Supabase auth.users.id
  email      String   @unique
  fullName   String
  role       UserRole
  acceptedAt DateTime? // null = invited, not yet signed in
  deactivatedAt DateTime? // access revoked but row kept (owns marketplace history)
  emailNotifications Boolean @default(true) // master email switch
  notificationPrefs Json?    // { [category]: { email: bool, inApp: bool } } — absent = catalog defaults
  createdAt  DateTime @default(now())

  gatePassesCreated GatePass[]
  gatePassScans     GatePassScan[]
  announcements     Announcement[]
  homeowners        Homeowner[]
  paymentsSubmitted Payment[] @relation("PaymentSubmittedBy")
  paymentsConfirmed Payment[] @relation("PaymentConfirmedBy")
  auditEvents       AuditEvent[]
  impersonatedAs    ImpersonationEvent[]
  marketplaceListings   MarketplaceListing[]  @relation("ListingSeller")
  listingReports        ListingReport[]       @relation("ReportReporter")
  conversationsAsBuyer  MarketConversation[]  @relation("ConversationBuyer")
  conversationsAsSeller MarketConversation[]  @relation("ConversationSeller")
  marketMessages        MarketMessage[]       @relation("MessageSender")
  conversationReports   ConversationReport[]  @relation("ConvReportReporter")
  blocksMade            MarketplaceBlock[]    @relation("BlockBlocker")
  blocksAgainst         MarketplaceBlock[]    @relation("BlockBlocked")
  amenityBookings       AmenityBooking[]      @relation("BookingRequester")
  amenityBookingsDecided AmenityBooking[]     @relation("BookingDecidedBy")
  notifications         Notification[]
  documentsUploaded     Document[]            @relation("DocumentUploader")
  journalEntriesCreated JournalEntry[]        @relation("JournalEntryCreator")
  ownershipTransfersHandled OwnershipTransfer[] @relation("TransferHandledBy")
  dataRequests          DataRequest[]
  dataRequestsHandled   DataRequest[]         @relation("DataRequestHandledBy")
  creditApplicationsApplied CreditApplication[] @relation("CreditAppliedBy")
  refundsIssued         Refund[]              @relation("RefundIssuedBy")
  violationsReported    Violation[]           @relation("ViolationReporter")
  finesIssued           FineNotice[]          @relation("FineIssuer")
  billsCreated          Bill[]                @relation("BillCreatedBy")
  billPaymentsRecorded  BillPayment[]         @relation("BillPaymentRecordedBy")
  maintenanceRequested  MaintenanceRequest[]  @relation("MaintenanceRequester")
  maintenanceAssigned   MaintenanceRequest[]  @relation("MaintenanceAssignee")
  maintenanceComments   MaintenanceComment[]  @relation("MaintenanceCommentAuthor")
  meetingsCreated       BoardMeeting[]        @relation("MeetingCreatedBy")
  meetingRsvps          MeetingRsvp[]         @relation("MeetingRsvpUser")
  votesCreated          BoardVote[]           @relation("VoteCreatedBy")
  ballotsCast           Ballot[]              @relation("BallotCastBy")
  proxiesHeld           VoteProxy[]           @relation("ProxyHolder")
  proxiesGrantedByMe    VoteProxy[]           @relation("ProxyGrantedBy")
  readingsEntered       MeterReading[]        @relation("ReadingEnteredBy")

  @@index([orgId])
  @@map("users")
}

enum NotificationType {
  DUES_ISSUED
  PAYMENT_CONFIRMED
  PAYMENT_REJECTED
  PAYMENT_SUBMITTED
  INVOICE_OVERDUE
  ANNOUNCEMENT
  AMENITY_BOOKING_REQUESTED
  AMENITY_BOOKING_DECIDED
  AMENITY_BOOKING_CANCELLED
  MARKETPLACE_MESSAGE
  MARKETPLACE_LISTING_REPORTED
  MARKETPLACE_LISTING_MODERATED
  MARKETPLACE_CONVERSATION_REPORTED
  LATE_FEE_APPLIED
  PAYMENT_REFUNDED
  VIOLATION_NOTICE
  MAINTENANCE_UPDATE
  BOARD_MEETING
  BOARD_VOTE
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model Announcement {
  id          String   @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  title       String
  body        String
  publishedAt DateTime? // null = draft
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@map("announcements")
}

// ─────────────────────────────────────────────
// Properties & homeowners
// ─────────────────────────────────────────────

enum PropertyType {
  RESIDENTIAL
  COMMERCIAL
  TOWNHOUSE
}

model Property {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  unitNumber   String
  type         PropertyType @default(RESIDENTIAL)
  monthlyRate  Decimal  @db.Decimal(12, 2)
  ratePlanId   String?
  ratePlan     RatePlan? @relation(fields: [ratePlanId], references: [id])
  archivedAt   DateTime? // set when a unit is sold / moved out — stops billing
  // Unapplied resident credit (overpayments carried forward). Mirrors the
  // ledger's 2100 balance for this unit; auto-applied to the next invoice.
  creditBalance Decimal @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  homeowners Homeowner[]
  invoices   Invoice[]
  gatePasses GatePass[]
  ownershipTransfers OwnershipTransfer[]
  creditApplications CreditApplication[]
  refunds    Refund[]
  violations Violation[]
  maintenanceRequests MaintenanceRequest[]
  ballots    Ballot[]
  proxiesGranted VoteProxy[]
  waterMeter WaterMeter?

  @@unique([orgId, unitNumber])
  @@index([orgId])
  @@index([ratePlanId])
  @@index([orgId, archivedAt])
  @@map("properties")
}

enum TransferSettlement {
  SETTLED               // balance was already zero
  WRITTEN_OFF           // remaining balance written off to bad debt
  CARRIED_TO_NEW_OWNER  // balance stays on the unit for the incoming owner
}

// A record of a unit changing hands or being vacated.
model OwnershipTransfer {
  id                String   @id @default(uuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  propertyId        String
  property          Property @relation(fields: [propertyId], references: [id])
  previousOwnerName String
  newOwnerName      String?
  vacated           Boolean  @default(false) // unit left empty, no incoming owner
  finalBalance      Decimal  @db.Decimal(12, 2)
  settlement        TransferSettlement
  effectiveDate     DateTime
  handledById       String?
  handledBy         User?    @relation("TransferHandledBy", fields: [handledById], references: [id])
  note              String?
  createdAt         DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([propertyId])
  @@map("ownership_transfers")
}

enum HomeownerRole {
  OWNER
  CO_OWNER
  RENTER
}

model Homeowner {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String?  // linked portal login — one login may own several units
  user       User?    @relation(fields: [userId], references: [id])
  fullName   String
  role       HomeownerRole @default(OWNER)
  email      String?
  phone      String?
  isPrimary  Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([userId])
  @@map("homeowners")
}

// ─────────────────────────────────────────────
// Billing
// ─────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum LateFeeType {
  FIXED   // flat peso amount
  PERCENT // percentage of the overdue balance
}

model Invoice {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  period     String?  // billing period this invoice covers, "YYYY-MM"
  dueDate    DateTime
  status     InvoiceStatus @default(DRAFT)
  memo       String?
  voidedAt   DateTime?
  voidReason String?
  createdAt  DateTime @default(now())
  // A late-fee invoice points back at the overdue dues invoice it was charged on.
  lateFeeParentId String?
  lateFeeParent   Invoice?  @relation("InvoiceLateFees", fields: [lateFeeParentId], references: [id])
  lateFeeChildren Invoice[] @relation("InvoiceLateFees")

  payments      Payment[]
  allocations   PaymentAllocation[]
  creditApplications CreditApplication[]
  journalEntry  JournalEntry?
  amenityBooking AmenityBooking?
  fineNotice    FineNotice?
  meterReading  MeterReading?

  @@unique([propertyId, period])
  @@index([propertyId])
  @@index([status])
  @@index([lateFeeParentId])
  @@map("invoices")
}

enum PaymentMethod {
  CASH
  CHECK
  BANK_TRANSFER
  GCASH
  MAYA
  WRITE_OFF // not a real payment — an uncollectible balance cleared on close-out
}

enum PaymentStatus {
  PENDING   // submitted by a homeowner, awaiting admin confirmation
  CONFIRMED // posted to the ledger
  REJECTED
}

model Payment {
  id        String   @id @default(uuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)
  method    PaymentMethod
  status    PaymentStatus @default(CONFIRMED)
  reference String?
  note      String?  // homeowner note or admin rejection reason
  paidAt    DateTime @default(now())

  submittedById String?
  submittedBy   User?   @relation("PaymentSubmittedBy", fields: [submittedById], references: [id])
  confirmedById String?
  confirmedBy   User?   @relation("PaymentConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?

  journalEntry JournalEntry?
  allocations  PaymentAllocation[]

  @@index([invoiceId])
  @@index([status])
  @@map("payments")
}

// How much of one payment landed on one invoice. The source of truth for
// "amount paid on this invoice" — a payment may split across several invoices,
// and any remainder becomes resident credit (see Property.creditBalance).
model PaymentAllocation {
  id        String  @id @default(uuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  amount    Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// Cash paid back to a resident against their credit balance (DR 2100 / CR 1000).
model Refund {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id])
  amount       Decimal  @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  reason       String
  note         String?
  refundedById String?
  refundedBy   User?    @relation("RefundIssuedBy", fields: [refundedById], references: [id])
  refundedAt   DateTime @default(now())

  @@index([orgId])
  @@index([propertyId])
  @@map("refunds")
}

// A stored resident credit consumed by a later invoice (DR 2100 / CR 1100).
model CreditApplication {
  id          String   @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  amount      Decimal  @db.Decimal(12, 2)
  appliedById String?
  appliedBy   User?    @relation("CreditAppliedBy", fields: [appliedById], references: [id])
  appliedAt   DateTime @default(now())

  @@index([propertyId])
  @@index([invoiceId])
  @@map("credit_applications")
}

// ─────────────────────────────────────────────
// Violations & fines
// ─────────────────────────────────────────────

enum ViolationStatus {
  OPEN
  CURED       // resident fixed it
  DISMISSED   // staff dropped it
  APPEALED    // resident is contesting it
}

enum ViolationCategory {
  NOISE
  PARKING
  PET
  WASTE
  LANDSCAPING
  ARCHITECTURAL
  NUISANCE
  SAFETY
  OTHER
}

model Violation {
  id             String   @id @default(uuid())
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  propertyId     String
  property       Property @relation(fields: [propertyId], references: [id])
  reportedById   String?
  reportedBy     User?    @relation("ViolationReporter", fields: [reportedById], references: [id])
  category       ViolationCategory
  description    String
  status         ViolationStatus @default(OPEN)
  occurredAt     DateTime
  cureByDate     DateTime?
  photos         String[] // storage paths in the private "violations" bucket
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime @default(now())

  fineNotices    FineNotice[]

  @@index([orgId, status])
  @@index([propertyId])
  @@map("violations")
}

// A formal fine served on a violation. Its `amount` is billed as a period:null
// Invoice (memo "Fine — …"), so it flows onto the resident's SOA and ledger.
model FineNotice {
  id           String   @id @default(uuid())
  violationId  String
  violation    Violation @relation(fields: [violationId], references: [id], onDelete: Cascade)
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  noticeNumber Int      // 1st notice, 2nd notice, … per violation
  amount       Decimal  @db.Decimal(12, 2)
  invoiceId    String?  @unique
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  issuedById   String?
  issuedBy     User?    @relation("FineIssuer", fields: [issuedById], references: [id])
  issuedAt     DateTime @default(now())
  dueDate      DateTime
  note         String?

  @@index([orgId])
  @@index([violationId])
  @@map("fine_notices")
}

// ─────────────────────────────────────────────
// Vendors & bills (accounts payable)
// ─────────────────────────────────────────────

enum BillStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

model Vendor {
  id          String   @id @default(uuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])
  name        String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())

  bills       Bill[]
  maintenanceRequests MaintenanceRequest[]

  @@index([orgId])
  @@map("vendors")
}

// A bill owed to a vendor. Issuing it books the expense and an A/P liability
// (DR expenseAccountCode / CR 2000); paying it draws down A/P and cash.
model Bill {
  id                 String   @id @default(uuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id])
  vendorId           String
  vendor             Vendor @relation(fields: [vendorId], references: [id])
  billNumber         String?
  description        String
  amount             Decimal  @db.Decimal(12, 2)
  billDate           DateTime
  dueDate            DateTime
  status             BillStatus @default(UNPAID)
  expenseAccountCode String   // an EXPENSE account code, e.g. "5100"
  createdById        String?
  createdBy          User?    @relation("BillCreatedBy", fields: [createdById], references: [id])
  voidedAt           DateTime?
  voidReason         String?
  createdAt          DateTime @default(now())

  payments     BillPayment[]
  journalEntry JournalEntry?
  maintenanceRequests MaintenanceRequest[]

  @@index([orgId, status])
  @@index([vendorId])
  @@map("bills")
}

model BillPayment {
  id           String   @id @default(uuid())
  billId       String
  bill         Bill @relation(fields: [billId], references: [id], onDelete: Cascade)
  amount       Decimal  @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime @default(now())
  recordedById String?
  recordedBy   User?    @relation("BillPaymentRecordedBy", fields: [recordedById], references: [id])

  journalEntry JournalEntry?

  @@index([billId])
  @@map("bill_payments")
}

// ─────────────────────────────────────────────
// Maintenance / work orders
// ─────────────────────────────────────────────

enum MaintenanceStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  HVAC
  APPLIANCE
  STRUCTURAL
  PEST
  LANDSCAPING
  COMMON_AREA
  SECURITY
  OTHER
}

model MaintenanceRequest {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  propertyId   String?
  property     Property? @relation(fields: [propertyId], references: [id])
  requesterId  String?
  requester    User?    @relation("MaintenanceRequester", fields: [requesterId], references: [id])
  category     MaintenanceCategory
  title        String
  description  String
  location     String?
  isCommonArea Boolean  @default(false)
  status       MaintenanceStatus @default(OPEN)
  photos       String[] // storage paths in the private "maintenance" bucket
  assignedToId String?
  assignedTo   User?    @relation("MaintenanceAssignee", fields: [assignedToId], references: [id])
  vendorId     String?
  vendor       Vendor?  @relation(fields: [vendorId], references: [id])
  billId       String?
  bill         Bill?    @relation(fields: [billId], references: [id])
  resolvedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  comments     MaintenanceComment[]

  @@index([orgId, status])
  @@index([propertyId])
  @@index([requesterId])
  @@map("maintenance_requests")
}

model MaintenanceComment {
  id        String   @id @default(uuid())
  requestId String
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation("MaintenanceCommentAuthor", fields: [authorId], references: [id])
  body      String
  staffOnly Boolean  @default(false) // internal note vs. visible to the requester
  createdAt DateTime @default(now())

  @@index([requestId])
  @@map("maintenance_comments")
}

// ─────────────────────────────────────────────
// Board meetings
// ─────────────────────────────────────────────

enum MeetingStatus {
  SCHEDULED
  HELD
  CANCELLED
}

enum RsvpResponse {
  YES
  NO
  MAYBE
}

model BoardMeeting {
  id                String   @id @default(uuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  title             String
  scheduledAt       DateTime
  location          String?
  agenda            String
  status            MeetingStatus @default(SCHEDULED)
  minutesDocumentId String?
  minutesDocument   Document? @relation(fields: [minutesDocumentId], references: [id], onDelete: SetNull)
  createdById       String?
  createdBy         User?    @relation("MeetingCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime @default(now())

  rsvps             MeetingRsvp[]
  votes             BoardVote[]

  @@index([orgId, scheduledAt])
  @@map("board_meetings")
}

model MeetingRsvp {
  id        String   @id @default(uuid())
  meetingId String
  meeting   BoardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("MeetingRsvpUser", fields: [userId], references: [id], onDelete: Cascade)
  response  RsvpResponse
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([meetingId, userId])
  @@index([meetingId])
  @@map("meeting_rsvps")
}

// ─────────────────────────────────────────────
// RA 9904 online voting (resolutions + proxy)
// ─────────────────────────────────────────────

enum VoteStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum VoteChoice {
  YES
  NO
  ABSTAIN
}

enum PassThreshold {
  MAJORITY   // more than 50% of YES + NO
  TWO_THIRDS // at least two-thirds of YES + NO
}

// A motion put to the members. One ballot per unit; a unit may delegate its
// ballot to another member via VoteProxy. Outcome = quorum met AND the YES
// share of YES+NO clears the threshold.
model BoardVote {
  id               String   @id @default(uuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id])
  meetingId        String?  // the meeting that raised it, optional
  meeting          BoardMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)
  title            String
  description      String
  status           VoteStatus @default(DRAFT)
  opensAt          DateTime
  closesAt         DateTime
  quorumPct        Int          // percent of eligible units that must cast a ballot
  threshold        PassThreshold @default(MAJORITY)
  resultDocumentId String?
  resultDocument   Document? @relation(fields: [resultDocumentId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?    @relation("VoteCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime @default(now())

  ballots          Ballot[]

  @@index([orgId, opensAt])
  @@map("board_votes")
}

model Ballot {
  id            String   @id @default(uuid())
  voteId        String
  vote          BoardVote @relation(fields: [voteId], references: [id], onDelete: Cascade)
  propertyId    String   // one ballot per unit
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  choice        VoteChoice
  castById      String?  // the user who submitted it
  castBy        User?    @relation("BallotCastBy", fields: [castById], references: [id], onDelete: SetNull)
  viaProxyForId String?  // set when a proxy holder cast on behalf of the grantor unit
  viaProxy      VoteProxy? @relation(fields: [viaProxyForId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([voteId, propertyId])
  @@index([voteId])
  @@map("ballots")
}

// A unit delegating its vote to another member. Active while revokedAt is null;
// applies to any vote that opens while active.
model VoteProxy {
  id                String   @id @default(uuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id])
  grantorPropertyId String
  grantorProperty   Property @relation(fields: [grantorPropertyId], references: [id], onDelete: Cascade)
  holderUserId      String
  holderUser        User     @relation("ProxyHolder", fields: [holderUserId], references: [id], onDelete: Cascade)
  grantedById       String?
  grantedBy         User?    @relation("ProxyGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  note              String?
  grantedAt         DateTime @default(now())
  revokedAt         DateTime?

  ballots           Ballot[]

  @@index([orgId])
  @@index([grantorPropertyId])
  @@index([holderUserId])
  @@map("vote_proxies")
}

// ─────────────────────────────────────────────
// Water sub-metering & tiered utility billing
// ─────────────────────────────────────────────

model WaterMeter {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  propertyId   String   @unique // one meter per unit in v1
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  serialNumber String?
  installedAt  DateTime?
  retiredAt    DateTime?
  createdAt    DateTime @default(now())

  readings     MeterReading[]

  @@index([orgId])
  @@map("water_meters")
}

// One month's reading for a meter. consumption = current − prior, and amount is
// the tiered charge — both stored so historical bills stay reproducible even if
// the org's rate bands change. Billed as its own period:null Invoice.
model MeterReading {
  id             String   @id @default(uuid())
  meterId        String
  meter          WaterMeter @relation(fields: [meterId], references: [id], onDelete: Cascade)
  orgId          String
  org            Organization @relation(fields: [orgId], references: [id])
  period         String   // "YYYY-MM"
  readingDate    DateTime
  priorReading   Decimal  @db.Decimal(12, 2)
  currentReading Decimal  @db.Decimal(12, 2)
  consumption    Decimal  @db.Decimal(12, 2)
  amount         Decimal  @db.Decimal(12, 2)
  invoiceId      String?  @unique
  invoice        Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  enteredById    String?
  enteredBy      User?    @relation("ReadingEnteredBy", fields: [enteredById], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime @default(now())

  @@unique([meterId, period])
  @@index([orgId, period])
  @@map("meter_readings")
}

// ─────────────────────────────────────────────
// Double-entry ledger
// ─────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model Account {
  id       String   @id @default(uuid())
  orgId    String
  org      Organization @relation(fields: [orgId], references: [id])
  code     String
  name     String
  type     AccountType
  parentId String?
  parent   Account? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children Account[] @relation("AccountHierarchy")

  journalLines JournalLine[]

  @@unique([orgId, code])
  @@index([orgId])
  @@map("accounts")
}

model JournalEntry {
  id         String   @id @default(uuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id])
  entryDate  DateTime @default(now()) // when the transaction is dated (not row creation)
  sourceType String   // "invoice" | "invoice_void" | "payment" | "manual" | "late_fee" | "write_off" | "fine" | "credit_applied" | "refund" | "void_to_credit" | "bill" | "bill_payment" | "bill_void"
  invoiceId  String?  @unique
  invoice    Invoice? @relation(fields: [invoiceId], references: [id])
  paymentId  String?  @unique
  payment    Payment? @relation(fields: [paymentId], references: [id])
  billId     String?  @unique
  bill       Bill?    @relation(fields: [billId], references: [id])
  billPaymentId String? @unique
  billPayment   BillPayment? @relation(fields: [billPaymentId], references: [id])
  memo       String?
  createdById String? // staff member who posted a manual entry
  createdBy   User?   @relation("JournalEntryCreator", fields: [createdById], references: [id])
  // A manual entry that reverses another (one reversal per entry).
  reversalOfId String?      @unique
  reversalOf   JournalEntry? @relation("JournalEntryReversal", fields: [reversalOfId], references: [id])
  reversedBy   JournalEntry? @relation("JournalEntryReversal")

  lines JournalLine[]

  @@index([orgId])
  @@index([orgId, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id      String   @id @default(uuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id])
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  debit   Decimal  @default(0) @db.Decimal(12, 2)
  credit  Decimal  @default(0) @db.Decimal(12, 2)

  @@index([entryId])
  @@index([accountId])
  @@map("journal_lines")
}

// ─────────────────────────────────────────────
// Gate passes
// ─────────────────────────────────────────────

enum GatePassStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

model GatePass {
  id          String   @id @default(uuid())
  code        String   @unique // short scannable code the guard enters
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  visitorName String
  validFrom   DateTime
  validUntil  DateTime
  status      GatePassStatus @default(ACTIVE)
  usedAt      DateTime? // single-use — set on the first successful guard scan
  createdAt   DateTime @default(now())

  scans GatePassScan[]

  @@index([propertyId])
  @@index([status])
  @@map("gate_passes")
}

model GatePassScan {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  gatePassId   String?
  gatePass     GatePass? @relation(fields: [gatePassId], references: [id])
  code         String   // exactly what the guard entered
  result       String   // VALID | EXPIRED | NOT_YET_VALID | REVOKED | NOT_FOUND
  scannedById  String
  scannedBy    User     @relation(fields: [scannedById], references: [id])
  scannedAt    DateTime @default(now())

  @@index([orgId, scannedAt])
  @@map("gate_pass_scans")
}

// ─────────────────────────────────────────────
// Resident marketplace (Phase 2)
// ─────────────────────────────────────────────

enum ListingCategory {
  FURNITURE
  APPLIANCES
  ELECTRONICS
  HOME_GARDEN
  VEHICLES
  CLOTHING
  KIDS
  SERVICES
  OTHER
}

enum ListingStatus {
  ACTIVE
  SOLD
  WITHDRAWN // taken down by the seller
  REMOVED   // taken down by a moderator
}

model MarketplaceListing {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  sellerId     String
  seller       User     @relation("ListingSeller", fields: [sellerId], references: [id])
  title        String
  description  String
  category     ListingCategory @default(OTHER)
  price        Decimal  @db.Decimal(12, 2)
  status       ListingStatus   @default(ACTIVE)
  photos       String[] // ordered Supabase Storage object paths
  removedReason String?
  soldAt       DateTime?
  expiresAt    DateTime // auto-hidden from browse once past; seller can renew
  bumpedAt     DateTime @default(now()) // browse sort key; renew resets it
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  conversations MarketConversation[]
  reports       ListingReport[]

  @@index([orgId, status, bumpedAt])
  @@index([sellerId])
  @@map("marketplace_listings")
}

model ListingReport {
  id         String   @id @default(uuid())
  listingId  String
  listing    MarketplaceListing @relation(fields: [listingId], references: [id])
  reporterId String
  reporter   User     @relation("ReportReporter", fields: [reporterId], references: [id])
  reason     String
  createdAt  DateTime @default(now())
  resolvedAt DateTime?

  @@unique([listingId, reporterId])
  @@index([listingId])
  @@map("listing_reports")
}

model MarketConversation {
  id            String   @id @default(uuid())
  orgId         String
  org           Organization @relation(fields: [orgId], references: [id])
  listingId     String
  listing       MarketplaceListing @relation(fields: [listingId], references: [id])
  buyerId       String
  buyer         User     @relation("ConversationBuyer", fields: [buyerId], references: [id])
  sellerId      String
  seller        User     @relation("ConversationSeller", fields: [sellerId], references: [id])
  closedAt      DateTime? // frozen by a moderator — no more messages
  closedReason  String?
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  messages MarketMessage[]
  reports  ConversationReport[]

  @@unique([listingId, buyerId])
  @@index([orgId])
  @@index([buyerId, lastMessageAt])
  @@index([sellerId, lastMessageAt])
  @@map("market_conversations")
}

model MarketMessage {
  id             String   @id @default(uuid())
  conversationId String
  conversation   MarketConversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User     @relation("MessageSender", fields: [senderId], references: [id])
  body           String
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
  @@map("market_messages")
}

model ConversationReport {
  id             String   @id @default(uuid())
  conversationId String
  conversation   MarketConversation @relation(fields: [conversationId], references: [id])
  reporterId     String
  reporter       User     @relation("ConvReportReporter", fields: [reporterId], references: [id])
  reason         String
  createdAt      DateTime @default(now())
  resolvedAt     DateTime?

  @@unique([conversationId, reporterId])
  @@index([conversationId])
  @@map("conversation_reports")
}

model MarketplaceBlock {
  id        String   @id @default(uuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id])
  blockerId String
  blocker   User     @relation("BlockBlocker", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlockBlocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([orgId])
  @@map("marketplace_blocks")
}

// ─────────────────────────────────────────────
// Amenity booking (Phase 2)
// ─────────────────────────────────────────────

enum AmenityBookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model Amenity {
  id               String   @id @default(uuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id])
  name             String
  description      String?
  fee              Decimal  @default(0) @db.Decimal(12, 2) // 0 = free (no invoice)
  feeNote          String?  // informational, e.g. "+ ₱3,000 refundable deposit at the office"
  capacity         Int      @default(1)  // concurrent CONFIRMED bookings allowed
  openHour         Int      @default(8)  // local hour 0–23
  closeHour        Int      @default(22)
  minNoticeHours   Int      @default(24)
  maxHours         Int      @default(4)
  cancellationCutoffHours Int @default(48) // inside this window, fee bookings can't be self-cancelled
  requiresApproval Boolean  @default(true)
  archivedAt       DateTime?
  createdAt        DateTime @default(now())

  bookings AmenityBooking[]

  @@index([orgId])
  @@map("amenities")
}

model AmenityBooking {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  amenityId    String
  amenity      Amenity  @relation(fields: [amenityId], references: [id])
  requesterId  String
  requester    User     @relation("BookingRequester", fields: [requesterId], references: [id])
  propertyId   String?  // requester's unit at request time — fee invoice target
  startAt      DateTime
  endAt        DateTime
  status       AmenityBookingStatus @default(PENDING)
  purpose      String?
  invoiceId    String?  @unique
  invoice      Invoice? @relation(fields: [invoiceId], references: [id])
  decidedById  String?
  decidedBy    User?    @relation("BookingDecidedBy", fields: [decidedById], references: [id])
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime @default(now())

  @@index([amenityId, startAt])
  @@index([orgId, status])
  @@index([requesterId])
  @@map("amenity_bookings")
}

// ─────────────────────────────────────────────
// Document library
// ─────────────────────────────────────────────

enum DocumentCategory {
  BYLAWS
  BOARD_MINUTES
  FINANCIAL_STATEMENT
  FORM
  POLICY
  NEWSLETTER
  OTHER
}

model Document {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  title        String
  description  String?
  category     DocumentCategory @default(OTHER)
  storagePath  String   // object key in the private "documents" bucket
  fileName     String   // original filename, shown to the user
  mimeType     String
  sizeBytes    Int
  staffOnly    Boolean  @default(false) // hidden from the homeowner portal
  uploadedById String?
  uploadedBy   User?    @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  meetingMinutes BoardMeeting[]
  voteResults    BoardVote[]

  @@index([orgId, category])
  @@index([orgId, createdAt])
  @@map("documents")
}

// ─────────────────────────────────────────────
// Data-privacy requests (RA 10173)
// ─────────────────────────────────────────────

enum DataRequestType {
  EXPORT
  DELETION
}

enum DataRequestStatus {
  PENDING
  COMPLETED
  REJECTED
  CANCELLED
}

model DataRequest {
  id           String   @id @default(uuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         DataRequestType
  status       DataRequestStatus @default(PENDING)
  reason       String?
  handledById  String?
  handledBy    User?    @relation("DataRequestHandledBy", fields: [handledById], references: [id])
  handledAt    DateTime?
  decisionNote String?
  createdAt    DateTime @default(now())

  @@index([orgId, status])
  @@index([userId])
  @@map("data_requests")
}
