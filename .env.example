# Postgres (Supabase). Transaction pooler for the app, session pooler for migrations.
DATABASE_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Optional — a throwaway Postgres for the integration test suite
# (`npm run test:integration`). Leave unset and those tests skip themselves;
# CI spins up an ephemeral postgres service and sets this automatically.
DATABASE_URL_TEST=""

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."          # invites, seed auth users, marketplace photo uploads

# Absolute origin for links in emails / shareable pass links (optional in dev)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email notifications (optional — notifications no-op without a key; in-app still works)
RESEND_API_KEY=""                         # https://resend.com → API Keys
EMAIL_FROM="HOA SaaS <onboarding@resend.dev>"

# Scheduled sweeps — required to expose GET /api/cron/overdue and
# /api/cron/late-fees (point a daily scheduler at them with
# Authorization: Bearer <this value>; vercel.json wires both on Vercel).
CRON_SECRET=""
